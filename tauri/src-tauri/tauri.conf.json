{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Sigillo",
  "version": "2.2.0",
  "identifier": "ai.sistemo.sigillo",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "splash",
        "title": "Sigillo",
        "width": 460,
        "height": 400,
        "resizable": false,
        "center": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "sistemo.ai",
    "copyright": "© sistemo.ai · basato su rizzo-pii © 2026 Simone Rizzo (MIT)",
    "category": "Productivity",
    "shortDescription": "Sigillo — anonimizzazione in locale",
    "longDescription": "Sigillo: anonimizza documenti legali in locale (modello rizzo-pii di Simone Rizzo) prima di inviarli a un LLM. Ogni dato sensibile diventa un placeholder reversibile. Nessun dato lascia il computer. GDPR compliant.",
    "resources": ["backend/**/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Italian"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    }
  }
}
